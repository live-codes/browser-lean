diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
index 3cbea55a..3b408132 100644
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -211,7 +211,7 @@ if(CMAKE_SYSTEM_NAME MATCHES "Emscripten")
     # must reach every compile: -pthread (atomics/TLS) and the EH mode. Flags
     # that only shape the final JS/wasm output live in EMSCRIPTEN_LINK_SETTINGS
     # so that link-only experiments keep the ccache'd objects valid.
-    set(EMSCRIPTEN_SETTINGS "-sDISABLE_EXCEPTION_CATCHING=0 -pthread")
+    set(EMSCRIPTEN_SETTINGS "-fwasm-exceptions")
     set(EMSCRIPTEN_LINK_SETTINGS "-sALLOW_MEMORY_GROWTH=1 -sINCOMING_MODULE_JS_API=print,printErr,setStatus,locateFile,mainScriptUrlOrBlob,INITIAL_MEMORY,wasmMemory,noInitialRun,preRun,onRuntimeInitialized,onAbort,onExit,arguments,ENV")
 
   # EMSCRIPTEN_DEBUG: Enable readable function names and assertions for debugging
@@ -672,7 +672,10 @@ elseif(CMAKE_SYSTEM_NAME MATCHES "Darwin")
 endif()
 # Linux ignores undefined symbols in shared libraries by default
 
-if(MULTI_THREAD AND NOT MSVC AND NOT CMAKE_SYSTEM_NAME MATCHES "Darwin")
+# wasm-build: Emscripten excluded. `-pthread` here reaches the wasm link line, where it re-enables
+# threads and the shared memory that `EMSCRIPTEN_SETTINGS` just stopped asking for — a build that
+# is single-threaded everywhere except the one place that decides the memory.
+if(MULTI_THREAD AND NOT MSVC AND NOT CMAKE_SYSTEM_NAME MATCHES "Darwin" AND NOT CMAKE_SYSTEM_NAME MATCHES "Emscripten")
   string(APPEND LEAN_EXTRA_LINKER_FLAGS " -pthread")
 endif()
 
@@ -920,9 +923,11 @@ if(CMAKE_SYSTEM_NAME MATCHES "Emscripten")
   # memory does NOT grow here (the browser's SharedArrayBuffer isn't resizable in
   # this config), so the worker reserves the real size up front; MAXIMUM_MEMORY=4GB
   # raises the wasm32 ceiling from 2GB so we can test whether the import fits.
+  # wasm-build: the pool is gone with -pthread. Its sub-workers were why this project had to fetch
+  # and import lean.js as a same-origin blob, and why a 4-worker pool had to be pre-spawned.
   string(
     APPEND LEAN_EXE_LINKER_FLAGS
-    " ${LIB}/temp/libleanshell.a ${TOOLCHAIN_STATIC_LINKER_FLAGS} ${EMSCRIPTEN_SETTINGS} ${EMSCRIPTEN_LINK_SETTINGS} -lnodefs.js -s EXIT_RUNTIME=1 -s MAIN_MODULE=2 -s ERROR_ON_UNDEFINED_SYMBOLS=0 -sEXPORTED_FUNCTIONS=@${LEAN_SOURCE_DIR}/emscripten-exports.txt -sEXPORTED_RUNTIME_METHODS=ccall,callMain,FS,ENV,getValue,setValue,stringToNewUTF8,UTF8ToString -s STACK_SIZE=16777216 -sINITIAL_MEMORY=67108864 -sMAXIMUM_MEMORY=4294967296 -sPTHREAD_POOL_SIZE=4"
+    " ${LIB}/temp/libleanshell.a ${TOOLCHAIN_STATIC_LINKER_FLAGS} ${EMSCRIPTEN_SETTINGS} ${EMSCRIPTEN_LINK_SETTINGS} -lnodefs.js -s EXIT_RUNTIME=1 -s MAIN_MODULE=2 -s ERROR_ON_UNDEFINED_SYMBOLS=0 -sEXPORTED_FUNCTIONS=@${LEAN_SOURCE_DIR}/emscripten-exports.txt -sEXPORTED_RUNTIME_METHODS=ccall,callMain,FS,ENV,getValue,setValue,stringToNewUTF8,UTF8ToString -s STACK_SIZE=${LEAN_WASM_STACK_SIZE} -sINITIAL_MEMORY=${LEAN_WASM_INITIAL_MEMORY} -sMAXIMUM_MEMORY=4294967296"
   )
 endif()
 
